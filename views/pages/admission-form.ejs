<% layout("layouts/boilerplate") %>

    <link rel="stylesheet" href="/css/admission-form-professional.css">
    <script src="/js/print-receipt.js"></script>

    <section class="admission-form-section py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="form-card shadow-lg bg-white rounded-4 overflow-hidden">

                        <!-- Header Section -->
                        <div class="form-header text-center py-4 px-4">
                            <div class="school-logo mb-3">
                                <img src="/img/logo.jpg" alt="Blossom World Logo" height="80" class="img-fluid">
                            </div>
                            <h1 class="mb-2 fw-bold text-white">BLOSSOM WORLD SENIOR SECONDARY SCHOOL</h1>
                            <p class="text-white-50 mb-0 small">Uttarkrishnapur-II, Cachar, Assam</p>
                            <div class="application-title mt-4">
                                <h3 class="bg-white text-navy d-inline-block px-4 py-2 rounded-pill shadow-sm fw-bold">
                                    APPLICATION FOR ADMISSION (2026-27)</h3>
                            </div>
                        </div>

                        <!-- Form Content -->
                        <form id="admissionForm" action="/submit-admission" method="POST" class="p-4 p-lg-5"
                            enctype="multipart/form-data">

                            <!-- Photo Upload Section -->
                            <div class="form-section mb-5">
                                <div class="section-header mb-4">
                                    <h4 class="section-title text-navy fw-bold mb-3">
                                        <i class="bi bi-camera-fill me-2 text-orange"></i>Student Photograph
                                    </h4>
                                    <p class="text-muted small mb-0">Please upload a recent passport-size color photograph (Maximum 1MB)</p>
                                </div>
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <div class="upload-area border-2 border-dashed rounded-3 p-4 text-center bg-light">
                                            <input type="file" name="studentPhoto" id="studentPhoto"
                                                class="form-control d-none" accept="image/*" required>
                                            <label for="studentPhoto" class="upload-label cursor-pointer">
                                                <i class="bi bi-cloud-upload text-muted" style="font-size: 2rem;"></i>
                                                <p class="mb-1 fw-semibold text-navy">Click to upload photo</p>
                                                <p class="small text-muted mb-0">PNG, JPG up to 1MB</p>
                                            </label>
                                        </div>
                                        <div id="photoError" class="text-danger small mt-2 fw-bold d-none">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            PHOTO SIZE SHOULD BE MAXIMUM 1MB. PLEASE COMPRESS AND TRY AGAIN.
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-center">
                                        <div class="photo-preview mx-auto">
                                            <div id="photoPreview"
                                                class="border-2 rounded-3 d-flex align-items-center justify-content-center bg-light"
                                                style="width: 140px; height: 160px; border-style: dashed !important; border-color: #dee2e6 !important;">
                                                <span class="text-muted small">Photo Preview</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Application Introduction -->
                            <div class="application-intro mb-5 p-4 bg-light rounded-3 border-start border-4 border-navy">
                                <p class="mb-0 fw-semibold text-navy">
                                    <strong>To: The Principal,</strong><br>
                                    Blossom World Senior Secondary School<br>
                                    Uttarkrishnapur-II, Cachar, Assam
                                </p>
                                <p class="mt-3 mb-0">
                                    Sir/Madam,<br>
                                    I hereby apply for admission of my son/daughter/ward in your esteemed institution.
                                    The required particulars are furnished below:
                                </p>
                            </div>

                            <!-- Student Particulars Section -->
                            <div class="form-section mb-5">
                                <div class="section-header mb-4">
                                    <h4 class="section-title text-navy fw-bold">
                                        <i class="bi bi-person-fill me-2 text-orange"></i>1. Student Information
                                    </h4>
                                </div>
                                <div class="form-content p-4 bg-white border rounded-3 shadow-sm">

                                    <!-- Student Name -->
                                    <div class="row mb-4">
                                        <div class="col-12">
                                            <label class="form-label fw-bold text-navy mb-3">
                                                <i class="bi bi-person-lines-fill me-1"></i>Full Name (IN BLOCK LETTERS) <span class="text-danger">*</span>
                                            </label>
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <input type="text" name="data[firstName]" placeholder="First Name"
                                                        class="form-control form-control-lg border-2 text-uppercase fw-bold"
                                                        required>
                                                </div>
                                                <div class="col-md-4">
                                                    <input type="text" name="data[middleName]" placeholder="Middle Name"
                                                        class="form-control form-control-lg border-2 text-uppercase fw-bold">
                                                </div>
                                                <div class="col-md-4">
                                                    <input type="text" name="data[lastName]" placeholder="Last Name"
                                                        class="form-control form-control-lg border-2 text-uppercase fw-bold"
                                                        required>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Personal Details Row -->
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-credit-card-2-front me-1"></i>Aadhaar Number
                                            </label>
                                            <input type="text" name="data[aadhaarNumber]"
                                                class="form-control form-control-lg border-2"
                                                inputmode="numeric" autocomplete="off" pattern="^[0-9]{12}$"
                                                minlength="12" maxlength="12" placeholder="12-digit Aadhaar number">
                                            <div class="invalid-feedback field-error-message"></div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-upc-scan me-1"></i>APAAR ID
                                            </label>
                                            <input type="text" name="data[apaarId]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="APAAR ID if available">
                                        </div>
                                    </div>

                                    <!-- Academic & Personal Info -->
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-calendar-event me-1"></i>Class to be Admitted <span class="text-danger">*</span>
                                            </label>
                                            <select name="data[requiredClass]" id="classSelect"
                                                class="form-select form-select-lg border-2 fw-bold" required>
                                                <option value="" disabled selected>Choose Class</option>
                                                <option>Nursery</option>
                                                <option>KG</option>
                                                <option>Class I</option>
                                                <option>Class II</option>
                                                <option>Class III</option>
                                                <option>Class IV</option>
                                                <option>Class V</option>
                                                <option>Class VI</option>
                                                <option>Class VII</option>
                                                <option>Class VIII</option>
                                                <option>Class IX</option>
                                                <option>Class X</option>
                                                <option value="XI">Class XI</option>
                                                <option value="XII">Class XII</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-calendar-date me-1"></i>Date of Birth <span class="text-danger">*</span>
                                            </label>
                                            <input type="date" name="data[dob]"
                                                class="form-control form-control-lg border-2" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-gender-ambiguous me-1"></i>Gender <span class="text-danger">*</span>
                                            </label>
                                            <select name="data[gender]" class="form-select form-select-lg border-2" required>
                                                <option value="">Select Gender</option>
                                                <option>Male</option>
                                                <option>Female</option>
                                                <option>Other</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-droplet me-1"></i>Blood Group
                                            </label>
                                            <input type="text" name="data[bloodGroup]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="e.g. O+, A-, B+">
                                        </div>
                                    </div>

                                    <!-- Additional Details -->
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-fingerprint me-1"></i>Identification Mark
                                            </label>
                                            <input type="text" name="data[identificationMark]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="e.g. Mole on left cheek">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-envelope me-1"></i>Email Address
                                            </label>
                                            <input type="email" name="data[email]"
                                                class="form-control form-control-lg border-2" placeholder="Optional">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-mortarboard me-1"></i>Last Class Passed
                                            </label>
                                            <input type="text" name="data[lastClassPassed]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="e.g. Class V (Optional)">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-house-door me-1"></i>Admission Type
                                            </label>
                                            <select name="data[admissionType]" class="form-select form-select-lg border-2">
                                                <option value="">Select Type (Optional)</option>
                                                <option>Boarder</option>
                                                <option>Day Boarder</option>
                                                <option>Day Scholar</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Additional Fields -->
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-star me-1"></i>Religion
                                            </label>
                                            <input type="text" name="data[religion]"
                                                class="form-control form-control-lg border-2">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-people me-1"></i>Caste
                                            </label>
                                            <input type="text" name="data[caste]"
                                                class="form-control form-control-lg border-2">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-flag me-1"></i>Nationality
                                            </label>
                                            <input type="text" name="data[nationality]"
                                                class="form-control form-control-lg border-2" value="Indian">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Senior Secondary Stream Selection -->
                            <div id="seniorSecondarySection" class="form-section mb-5 d-none">
                                <div class="section-header mb-4">
                                    <h5 class="section-title text-navy fw-bold">
                                        <i class="bi bi-journal-bookmark-fill me-2 text-orange"></i>Stream Selection (Class XI-XII)
                                    </h5>
                                </div>
                                <div class="form-content p-4 bg-light border rounded-3">
                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-diagram-3 me-1"></i>Select Stream
                                            </label>
                                            <select name="data[stream]" id="streamSelect"
                                                class="form-select form-select-lg border-2 bg-white fw-bold">
                                                <option value="" selected>Choose Your Stream (Optional)</option>
                                                <option value="Science">Science</option>
                                                <option value="Commerce">Commerce</option>
                                                <option value="Arts">Arts</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div id="subjectSection" class="mt-4 d-none">
                                        <div class="subject-selection p-4 bg-white border rounded-3 shadow-sm">
                                            <h6 class="fw-bold text-navy mb-4">
                                                <i class="bi bi-check2-square me-2 text-orange"></i>Choose Your Elective Subjects
                                            </h6>
                                            <div id="subjectOptions" class="row g-3"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Parental Information Section -->
                            <div class="form-section mb-5">
                                <div class="section-header mb-4">
                                    <h4 class="section-title text-navy fw-bold">
                                        <i class="bi bi-people-fill me-2 text-orange"></i>2. Parental Information
                                    </h4>
                                </div>
                                <div class="row g-4">
                                    <!-- Father's Information -->
                                    <div class="col-md-6">
                                        <div class="parent-card p-4 bg-light border rounded-3 h-100">
                                            <h5 class="text-navy fw-bold mb-4 border-bottom pb-2">
                                                <i class="bi bi-person-standing me-2"></i>Father's Details
                                            </h5>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold text-navy small">
                                                    <i class="bi bi-person-lines-fill me-1"></i>Full Name <span class="text-danger">*</span>
                                                </label>
                                                <input type="text" name="data[fatherName]"
                                                    class="form-control form-control-lg border-2" required>
                                            </div>
                                            <div class="row g-3 mb-3">
                                                <div class="col-6">
                                                    <label class="form-label fw-bold text-navy small">
                                                        <i class="bi bi-briefcase me-1"></i>Occupation
                                                    </label>
                                                    <input type="text" name="data[fatherOccupation]"
                                                        class="form-control border-2">
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label fw-bold text-navy small">
                                                        <i class="bi bi-cash-coin me-1"></i>Annual Income
                                                    </label>
                                                    <input type="text" name="data[fatherIncome]"
                                                        class="form-control border-2" placeholder="₹">
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold text-navy small">
                                                    <i class="bi bi-mortarboard-fill me-1"></i>Educational Qualification
                                                </label>
                                                <input type="text" name="data[fatherEducation]"
                                                    class="form-control border-2">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold text-navy small">
                                                    <i class="bi bi-credit-card-2-front me-1"></i>Aadhaar Number
                                                </label>
                                                <input type="text" name="data[fatherAadhaar]"
                                                    class="form-control border-2" inputmode="numeric" autocomplete="off"
                                                    pattern="^[0-9]{12}$" minlength="12" maxlength="12">
                                                <div class="invalid-feedback field-error-message"></div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-6">
                                                    <label class="form-label fw-bold text-navy small">
                                                        <i class="bi bi-telephone me-1"></i>Contact Number <span class="text-danger">*</span>
                                                    </label>
                                                    <input type="tel" name="data[mobile]"
                                                        class="form-control border-2" inputmode="numeric"
                                                        autocomplete="tel" pattern="^[0-9]{10}$" minlength="10"
                                                        maxlength="10" required>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label fw-bold text-navy small">
                                                        <i class="bi bi-whatsapp me-1"></i>WhatsApp Number
                                                    </label>
                                                    <input type="tel" name="data[fatherWhatsApp]"
                                                        class="form-control border-2" inputmode="numeric"
                                                        autocomplete="tel" pattern="^[0-9]{10}$" minlength="10"
                                                        maxlength="10">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Mother's Information -->
                                    <div class="col-md-6">
                                        <div class="parent-card p-4 bg-light border rounded-3 h-100">
                                            <h5 class="text-navy fw-bold mb-4 border-bottom pb-2">
                                                <i class="bi bi-person-standing-dress me-2"></i>Mother's Details
                                            </h5>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold text-navy small">
                                                    <i class="bi bi-person-lines-fill me-1"></i>Full Name <span class="text-danger">*</span>
                                                </label>
                                                <input type="text" name="data[motherName]"
                                                    class="form-control form-control-lg border-2" required>
                                            </div>
                                            <div class="row g-3 mb-3">
                                                <div class="col-6">
                                                    <label class="form-label fw-bold text-navy small">
                                                        <i class="bi bi-briefcase me-1"></i>Occupation
                                                    </label>
                                                    <input type="text" name="data[motherOccupation]"
                                                        class="form-control border-2">
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label fw-bold text-navy small">
                                                        <i class="bi bi-cash-coin me-1"></i>Annual Income
                                                    </label>
                                                    <input type="text" name="data[motherIncome]"
                                                        class="form-control border-2" placeholder="₹">
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold text-navy small">
                                                    <i class="bi bi-mortarboard-fill me-1"></i>Educational Qualification
                                                </label>
                                                <input type="text" name="data[motherEducation]"
                                                    class="form-control border-2">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold text-navy small">
                                                    <i class="bi bi-credit-card-2-front me-1"></i>Aadhaar Number
                                                </label>
                                                <input type="text" name="data[motherAadhaar]"
                                                    class="form-control border-2" inputmode="numeric" autocomplete="off"
                                                    pattern="^[0-9]{12}$" minlength="12" maxlength="12">
                                                <div class="invalid-feedback field-error-message"></div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-6">
                                                    <label class="form-label fw-bold text-navy small">
                                                        <i class="bi bi-telephone me-1"></i>Contact Number
                                                    </label>
                                                    <input type="tel" name="data[motherContact]"
                                                        class="form-control border-2" inputmode="numeric"
                                                        autocomplete="tel" pattern="^[0-9]{10}$" minlength="10"
                                                        maxlength="10">
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label fw-bold text-navy small">
                                                        <i class="bi bi-whatsapp me-1"></i>WhatsApp Number
                                                    </label>
                                                    <input type="tel" name="data[motherWhatsApp]"
                                                        class="form-control border-2" inputmode="numeric"
                                                        autocomplete="tel" pattern="^[0-9]{10}$" minlength="10"
                                                        maxlength="10">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Address & Health Information Section -->
                            <div class="form-section mb-5">
                                <div class="section-header mb-4">
                                    <h4 class="section-title text-navy fw-bold">
                                        <i class="bi bi-geo-alt-fill me-2 text-orange"></i>3. Address & Health Information
                                    </h4>
                                </div>
                                <div class="form-content p-4 bg-white border rounded-3 shadow-sm">

                                    <!-- Address Information -->
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-house-door me-1"></i>Permanent Address <span class="text-danger">*</span>
                                            </label>
                                            <textarea name="data[permanentAddress]" id="permAddress"
                                                class="form-control form-control-lg border-2" rows="3"
                                                placeholder="Enter complete permanent address with PIN code" required></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <label class="form-label fw-bold text-navy mb-0">
                                                    <i class="bi bi-geo-alt me-1"></i>Present Residential Address <span class="text-danger">*</span>
                                                </label>
                                                <div class="form-check mb-0">
                                                    <input class="form-check-input" type="checkbox" id="syncAddress">
                                                    <label class="form-check-label text-orange fw-bold small" for="syncAddress">
                                                        Same as Permanent
                                                    </label>
                                                </div>
                                            </div>
                                            <textarea name="data[presentAddress]" id="presAddress"
                                                class="form-control form-control-lg border-2" rows="3"
                                                placeholder="Enter complete present address with PIN code" required></textarea>
                                        </div>
                                    </div>

                                    <!-- Additional Address & Health Details -->
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-shield-check me-1"></i>Name of Local Guardian
                                            </label>
                                            <input type="text" name="data[localGuardianName]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="If applicable">
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-people me-1"></i>Siblings Studying in School
                                            </label>
                                            <input type="text" name="data[siblingsInSchool]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="Name and Class (e.g., John Doe - Class VIII)">
                                        </div>
                                    </div>

                                    <!-- Health Information -->
                                    <div class="row g-4">
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-universal-access me-1"></i>Physically Handicapped
                                            </label>
                                            <select name="data[isHandicapped]" class="form-select form-select-lg border-2">
                                                <option value="No">No</option>
                                                <option value="Yes">Yes</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-rulers me-1"></i>Height (cm)
                                            </label>
                                            <input type="text" name="data[height]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="e.g., 145">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-speedometer me-1"></i>Weight (kg)
                                            </label>
                                            <input type="text" name="data[weight]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="e.g., 35">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-geo me-1"></i>Distance from School
                                            </label>
                                            <input type="text" name="data[distanceFromSchool]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="e.g., 5 km">
                                        </div>
                                    </div>

                                    <!-- Handicap Details (Conditional) -->
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-info-circle me-1"></i>If Physically Handicapped, Please Provide Details
                                            </label>
                                            <input type="text" name="data[handicapDetails]"
                                                class="form-control form-control-lg border-2"
                                                placeholder="Specify the nature of disability and any special requirements">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Transfer Students Information -->
                            <div class="form-section mb-5">
                                <div class="section-header mb-4">
                                    <h4 class="section-title text-navy fw-bold">
                                        <i class="bi bi-arrow-left-right me-2 text-orange"></i>4. Previous School Information (For Transfer Students)
                                    </h4>
                                    <p class="text-muted small mb-0">Please provide details of the student's previous school (if applicable)</p>
                                </div>
                                <div class="form-content p-4 bg-light border rounded-3">
                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-building me-1"></i>Name of Previous School
                                            </label>
                                            <input type="text" name="data[previousSchool]"
                                                class="form-control form-control-lg border-2 bg-white"
                                                placeholder="Enter full school name">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-upc-scan me-1"></i>DISE Code of Previous School
                                            </label>
                                            <input type="text" name="data[previousSchoolDise]"
                                                class="form-control form-control-lg border-2 bg-white"
                                                placeholder="School DISE code">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-hash me-1"></i>PEN No. / APAAR ID
                                            </label>
                                            <input type="text" name="data[previousSchoolPen]"
                                                class="form-control form-control-lg border-2 bg-white"
                                                placeholder="PEN/APAAR ID">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-graph-up me-1"></i>Previous Result (%)
                                            </label>
                                            <input type="text" name="data[previousResult]"
                                                class="form-control form-control-lg border-2 bg-white"
                                                placeholder="e.g., 85%">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-calendar-check me-1"></i>Total Attendance
                                            </label>
                                            <input type="text" name="data[previousSchoolAttendance]"
                                                class="form-control form-control-lg border-2 bg-white"
                                                placeholder="e.g., 95%">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold text-navy">
                                                <i class="bi bi-mortarboard me-1"></i>Class Last Attended
                                            </label>
                                            <input type="text" name="data[previousSchoolClass]"
                                                class="form-control form-control-lg border-2 bg-white"
                                                placeholder="e.g., Class V">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Documents Submitted -->
                            <div class="form-section mb-5">
                                <div class="section-header mb-4">
                                    <h4 class="section-title text-navy fw-bold">
                                        <i class="bi bi-file-earmark-check-fill me-2 text-orange"></i>5. Documents to be Submitted
                                    </h4>
                                    <p class="text-muted small mb-0">Please check all documents that will be submitted along with this application</p>
                                </div>
                                <div class="documents-grid p-4 bg-white border rounded-3 shadow-sm">
                                    <% const docList=[
                                        'Birth Certificate (Xerox)',
                                        "Father's Photo (2 copies)",
                                        "Student's Blood Group Certificate",
                                        "Aadhaar Card of Father (Xerox)",
                                        "Guardian's Aadhaar Card (Xerox)",
                                        "Student's Photo (4 copies)",
                                        "Mother's Photo (2 copies)",
                                        "Aadhaar Card of Student (Xerox)",
                                        "Aadhaar Card of Mother (Xerox)",
                                        "Transfer Certificate (T.C. Original)",
                                        "Marksheet (Original)"
                                    ]; %>
                                    <% docList.forEach((doc, index)=> { %>
                                        <div class="document-item">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                    name="data[documentsSubmitted]" value="<%= doc %>"
                                                    id="doc_<%= index %>">
                                                <label class="form-check-label fw-semibold text-navy"
                                                    for="doc_<%= index %>">
                                                    <i class="bi bi-file-earmark-text me-2 text-orange"></i>
                                                    <%= doc %>
                                                </label>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                            </div>

                            <!-- Declaration & Submission -->
                            <div class="form-section mb-5">
                                <div class="declaration-card p-4 border-start border-5 border-navy bg-light rounded-3 shadow-sm">
                                    <h5 class="text-navy fw-bold mb-3">
                                        <i class="bi bi-shield-check me-2 text-orange"></i>Declaration
                                    </h5>
                                    <div class="declaration-text p-3 bg-white rounded-3 border mb-3">
                                        <p class="mb-2 fw-semibold text-navy">I hereby declare that:</p>
                                        <ul class="mb-0 text-navy">
                                            <li>The information supplied above is true to the best of my knowledge and belief.</li>
                                            <li>The rules and regulations of the school shall be strictly adhered to by my ward.</li>
                                            <li>I understand that <strong>fees once paid will not be refunded</strong> under any circumstances.</li>
                                            <li>I will provide all necessary documents as required by the school administration.</li>
                                        </ul>
                                    </div>
                                    <div class="declaration-acceptance">
                                        <div class="form-check mb-3">
                                            <input class="form-check-input" type="checkbox" id="declaration" required>
                                            <label class="form-check-label fw-bold text-navy" for="declaration">
                                                I have read and accept the above declaration
                                            </label>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold text-navy">
                                                    <i class="bi bi-geo-alt me-1"></i>Place
                                                </label>
                                                <input type="text" name="data[applicationPlace]"
                                                    class="form-control form-control-lg border-2"
                                                    placeholder="City/District (Optional)">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold text-navy">
                                                    <i class="bi bi-calendar-date me-1"></i>Date
                                                </label>
                                                <input type="text" name="data[applicationDate]"
                                                    class="form-control form-control-lg border-2 bg-light"
                                                    value="<%= new Date().toLocaleDateString('en-IN') %>"
                                                    readonly>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <div class="text-center mb-5">
                                <button type="submit" id="submitBtn"
                                    class="btn btn-navy btn-lg rounded-pill px-5 py-3 shadow-lg fw-bold">
                                    <i class="bi bi-send-check me-2"></i>Submit Admission Application
                                </button>
                                <p class="text-muted small mt-2 mb-0">
                                    Please review all information before submitting. You will receive a confirmation email once submitted.
                                </p>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
        .bg-navy {
            background-color: #001f3f;
        }

        .text-navy {
            color: #001f3f;
        }

        .text-orange {
            color: #f37021;
        }

        .border-2 {
            border-width: 2px !important;
        }

        .section-title {
            color: #001f3f;
            font-weight: 800;
            text-transform: uppercase;
            border-left: 5px solid #f37021;
            padding-left: 15px;
        }

        .bg-light-orange {
            background-color: #fff4ed !important;
            border-color: #f37021 !important;
        }

        .subject-card {
            background: white;
            border: 2px solid #eee;
            padding: 12px;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s ease;
            display: flex;
            align-items: center;
        }

        .btn-navy {
            background-color: #001f3f;
            color: white;
            border: none;
            font-weight: 600;
            padding: 15px 50px;
        }
    </style>

    <script>
        const classSelect = document.getElementById('classSelect');
        const seniorSection = document.getElementById('seniorSecondarySection');
        const streamSelect = document.getElementById('streamSelect');
        const subjectSection = document.getElementById('subjectSection');
        const subjectOptions = document.getElementById('subjectOptions');

        // 1. Photo Size Validation
        document.getElementById('studentPhoto').addEventListener('change', function () {
            const file = this.files[0];
            const preview = document.getElementById('photoPreview');
            if (file && file.size > 1024 * 1024) {
                document.getElementById('photoError').classList.remove('d-none');
                this.value = '';
                preview.innerHTML = '<span class="text-danger fw-bold">Too Large</span>';
            } else if (file) {
                document.getElementById('photoError').classList.add('d-none');
                const reader = new FileReader();
                reader.onload = e => preview.innerHTML = `<img src="${e.target.result}" style="width:100%; height:100%; object-fit:cover;" class="rounded-3">`;
                reader.readAsDataURL(file);
            }
        });

        // 2. Address Sync
        document.getElementById('syncAddress').addEventListener('change', function () {
            const perm = document.getElementById('permAddress');
            const pres = document.getElementById('presAddress');
            if (this.checked) {
                pres.value = perm.value;
                pres.readOnly = true;
            } else {
                pres.readOnly = false;
            }
        });

        // 3. Dynamic Streams
        const streamSubjects = {
            Science: ['Physics', 'Chemistry', 'Mathematics', 'Biology', 'Computer Science'],
            Commerce: ['Accountancy', 'Business Studies', 'Economics', 'Commercial Math'],
            Arts: ['Political Science', 'History', 'Geography', 'Sociology', 'Logic & Philosophy']
        };

        classSelect.addEventListener('change', function () {
            if (this.value === 'XI' || this.value === 'XII') {
                seniorSection.classList.remove('d-none');
            } else {
                seniorSection.classList.add('d-none');
                subjectSection.classList.add('d-none');
                subjectOptions.innerHTML = '';
            }
        });

        streamSelect.addEventListener('change', function () {
            const stream = this.value;
            if (stream && streamSubjects[stream]) {
                subjectSection.classList.remove('d-none');
                subjectOptions.innerHTML = streamSubjects[stream].map(sub => `
                <div class="col-md-4 col-6">
                    <label class="subject-card" for="sub_${sub}"><input type="checkbox" name="data[selectedSubjects]" value="${sub}" id="sub_${sub}" class="form-check-input me-2"><span class="small fw-bold">${sub}</span></label>
                </div>
            `).join('');
            } else {
                subjectSection.classList.add('d-none');
                subjectOptions.innerHTML = '';
            }
        });

        const form = document.getElementById('admissionForm');
        const submitBtn = document.getElementById('submitBtn');

        /**
         * BACKEND VALIDATION MAPPING
         * Maps field names to specific error reasons
         * 
         * REQUIRED FIELDS (must have * and validation):
         * firstName, lastName, dob, gender, fatherName, motherName,
         * mobile, permanentAddress, presentAddress, requiredClass, studentPhoto
         */
        const VALIDATION_REASON_MAP = {
            'firstName': 'First Name is required',
            'lastName': 'Last Name is required',
            'dob': 'Date of Birth is required and must be a valid date',
            'gender': 'Please select a Gender (Male, Female, or Other)',
            'fatherName': 'Father\'s Name is required',
            'motherName': 'Mother\'s Name is required',
            'mobile': 'Mobile Number is required (exactly 10 digits, e.g., 9876543210)',
            'permanentAddress': 'Permanent Address is required - provide complete address',
            'presentAddress': 'Present Address is required - provide complete address',
            'requiredClass': 'Please select the Class you want to be admitted to',
            'aadhaar_format': 'Aadhaar card must be 12 digits',
            'mobile_format': 'Phone must contain exactly 10 digits',
            'studentPhoto': 'Student Photo is required (JPG, PNG, WEBP max 1MB)',
            'email': 'Email must be in valid format (e.g., student@gmail.com)'
        };

        // Auto-append units on blur (keeps typing simple; avoids fighting cursor while user edits).
        function attachUnit(input, unit) {
            if (!input) return;
            input.addEventListener('blur', () => {
                const raw = String(input.value || '').trim();
                if (!raw) return;
                const withoutUnit = raw.replace(new RegExp(`\\s*${unit}$`, 'i'), '').trim();
                if (!withoutUnit) return;
                input.value = `${withoutUnit} ${unit}`;
            });
        }

        attachUnit(document.querySelector('input[name="data[height]"]'), 'cm');
        attachUnit(document.querySelector('input[name="data[weight]"]'), 'kg');
        attachUnit(document.querySelector('input[name="data[distanceFromSchool]"]'), 'km');

        function fileToDataURL(file) {
            return new Promise((resolve, reject) => {
                if (!file) return resolve('');
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function reviewHtml(data) {
            const subjects = (data.selectedSubjects || []).join(', ') || 'N/A';
            const docs = (data.documentsSubmitted || []).join(', ') || 'N/A';
            return `
                <div style="text-align:left; max-height:55vh; overflow:auto; font-size:14px;">
                    <p><strong>Student:</strong> ${escapeHtml(`${data.firstName || ''} ${data.middleName || ''} ${data.lastName || ''}`.trim())}</p>
                    <p><strong>Class:</strong> ${escapeHtml(data.requiredClass || '')}</p>
                    <p><strong>DOB:</strong> ${escapeHtml(data.dob || '')}</p>
                    <p><strong>Gender:</strong> ${escapeHtml(data.gender || '')}</p>
                    <p><strong>Father:</strong> ${escapeHtml(data.fatherName || '')}</p>
                    <p><strong>Mother:</strong> ${escapeHtml(data.motherName || '')}</p>
                    <p><strong>Mobile:</strong> ${escapeHtml(data.mobile || '')}</p>
                    <p><strong>Address:</strong> ${escapeHtml(data.presentAddress || '')}</p>
                    <p><strong>Place:</strong> ${escapeHtml(data.applicationPlace || '')}</p>
                    <p><strong>Subjects:</strong> ${escapeHtml(subjects)}</p>
                    <p><strong>Documents:</strong> ${escapeHtml(docs)}</p>
                    <hr>
                    <p style="margin:0; color:#6c757d;">Click <b>Edit</b> to change details, or <b>Submit</b> to continue.</p>
                </div>
            `;
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            
            // Custom validation before form submission
            const validationResult = validateFormFields();
            
            if (!validationResult.isValid) {
                // Show red alert with missing fields
                await Swal.fire({
                    icon: 'error',
                    title: '⚠️ Required Fields Missing',
                    html: validationResult.missingFieldsHtml,
                    confirmButtonText: 'OK, I will fill them',
                    confirmButtonColor: '#dc3545',
                    allowOutsideClick: false,
                    didOpen: () => {
                        // Shake animation for emphasis
                        const popup = Swal.getPopup();
                        popup.style.animation = 'shake 0.3s ease-in-out';
                    }
                });
                
                // Focus on the first empty required field
                if (validationResult.firstEmptyField) {
                    setTimeout(() => {
                        validationResult.firstEmptyField.focus();
                        validationResult.firstEmptyField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        // Add red highlight
                        validationResult.firstEmptyField.classList.add('is-invalid');
                        validationResult.firstEmptyField.style.borderColor = '#dc3545';
                        validationResult.firstEmptyField.style.boxShadow = '0 0 10px rgba(220, 53, 69, 0.5)';
                    }, 300);
                }
                return;
            }
            
            
            // Browser validation check
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData(form);
            const plainData = {};
            for (const [key, value] of formData.entries()) {
                const match = key.match(/^data\[(.+)\]$/);
                const targetKey = match ? match[1] : key;
                if (plainData[targetKey] === undefined) {
                    plainData[targetKey] = value;
                }
            }
            const photoFile = document.getElementById('studentPhoto').files[0];
            plainData.studentPhotoDataUrl = await fileToDataURL(photoFile);
            plainData.selectedSubjects = formData.getAll('data[selectedSubjects]');
            plainData.documentsSubmitted = formData.getAll('data[documentsSubmitted]');

            const reviewResult = await Swal.fire({
                title: 'Review Before Submit',
                html: reviewHtml(plainData),
                showCancelButton: true,
                confirmButtonText: 'Submit',
                cancelButtonText: 'Edit',
                width: 700
            });

            if (!reviewResult.isConfirmed) {
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';

            try {
                const res = await fetch('/submit-admission', {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                });

                const raw = await res.text();
                const isJson = res.headers.get('content-type')?.includes('application/json');
                if (!isJson) {
                    throw new Error(raw || 'Server returned non-JSON response');
                }

                let data = {};
                try {
                    data = JSON.parse(raw);
                } catch (parseErr) {
                    throw new Error(`Invalid response format: ${parseErr.message}`);
                }

                if (!res.ok || !data.success) {
                    const errorMsg = data.message || `Server Error (${res.status}): ${res.statusText}` || 'Submission failed';
                    let errorHTML = `<div style="text-align: left; padding: 15px; background: #fff3cd; border-radius: 5px;">`;
                    errorHTML += `<h5 style="color: #dc3545; margin: 0 0 10px; font-size: 1.1em;">❌ Submission Error</h5>`;
                    errorHTML += `<div style="background: #fff; padding: 10px; border-left: 4px solid #dc3545; border-radius: 4px; margin-bottom: 10px;">`;
                    errorHTML += `<strong style="color: #dc3545; font-size: 1.05em;">${errorMsg}</strong>`;
                    errorHTML += `</div>`;
                    errorHTML += `<p style="margin: 8px 0; color: #666; font-size: 0.95em;"><strong>Status:</strong> ${res.status}</p>`;
                    errorHTML += `<div style="margin-top: 12px; padding: 10px; background: #e7f3ff; border-radius: 4px; color: #0066cc; font-size: 0.9em;">`;
                    errorHTML += `<strong>💡 Things to check:</strong><ul style="margin: 8px 0; padding-left: 20px;">`;
                    errorHTML += `<li>All fields marked with * are filled correctly</li>`;
                    errorHTML += `<li>Student photo is JPG/PNG (max 1MB)</li>`;
                    errorHTML += `<li>Mobile number is exactly 10 digits</li>`;
                    errorHTML += `<li>Date of Birth is a valid date</li>`;
                    errorHTML += `<li>All addresses are complete</li>`;
                    errorHTML += `</ul></div>`;
                    errorHTML += `</div>`;

                    await Swal.fire({
                        icon: 'error',
                        title: '❌ Submission Failed',
                        html: errorHTML,
                        confirmButtonColor: '#dc3545',
                        didOpen: () => {
                            const popup = Swal.getPopup();
                            popup.style.animation = 'shake 0.3s ease-in-out';
                        }
                    });

                    return;
                }

                const nextAction = await Swal.fire({
                    icon: 'success',
                    title: 'Application Submitted',
                    text: 'Choose what you want now.',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: 'Print',
                    denyButtonText: 'Download PDF',
                    cancelButtonText: 'Skip'
                });

                if (nextAction.isConfirmed) {
                    const appNo = `APP-2026-${String(data.applicationId).slice(-6).toUpperCase()}`;
                    printAdmissionReceipt(plainData, appNo);
                } else if (nextAction.isDenied) {
                    await downloadAdmissionPdf(plainData, data.applicationId);
                }

                form.reset();
                document.getElementById('photoPreview').innerHTML = '<span class="text-muted small">Preview</span>';
                document.getElementById('photoError').classList.add('d-none');
            } catch (err) {
                await Swal.fire({
                    icon: 'error',
                    title: '❌ Submission Failed',
                    html: `<div style="text-align: left; color: #333;">` +
                        `<p style="margin: 0 0 10px;"><strong>Error Message:</strong></p>` +
                        `<div style="background: #ffe6e6; padding: 10px; border-left: 4px solid #dc3545; border-radius: 4px; margin-bottom: 10px;">` +
                            `<strong style="color: #dc3545;">${escapeHtml(err.message || 'Unknown error occurred')}</strong>` +
                        `</div>` +
                        `<p style="font-size: 0.9em; color: #666; margin: 0;">` +
                            `If this error persists, please check your internet connection and try again, or contact support.` +
                        `</p>` +
                    `</div>`,
                    confirmButtonColor: '#dc3545'
                });
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit Application Form';
            }
        });

        /**
         * Validate All Required Form Fields with detailed error messages
         * @returns {Object} Validation result with isValid, missingFieldsHtml, and firstEmptyField
         */
        function validateFormFields() {
            const requiredFields = form.querySelectorAll('[required]');
            const validationErrors = [];
            let firstEmptyField = null;

            requiredFields.forEach((field) => {
                const value = String(field.value || '').trim();
                const fieldId = field.getAttribute('id');
                const fieldName = field.getAttribute('name') || fieldId || 'Unknown';
                const fieldType = field.getAttribute('type') || field.tagName.toLowerCase();
                
                let label = document.querySelector(`label[for="${fieldId}"]`)?.innerText || 
                           field.parentElement?.querySelector('label')?.innerText || fieldName;
                label = label.replace(/\s*\*\s*$/, '').trim();

                let error = null;
                let reason = '';

                // Photo validation (file input)
                if (fieldType === 'file') {
                    const fileInput = document.getElementById(fieldId);
                    if (!fileInput.files || fileInput.files.length === 0) {
                        reason = 'No file selected. JPG, PNG, or WEBP required (max 1MB)';
                        error = { field, label, reason, type: 'file' };
                    } else {
                        const file = fileInput.files[0];
                        const maxSize = 1 * 1024 * 1024; // 1MB
                        const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
                        
                        if (!allowedTypes.includes(file.type)) {
                            reason = `Invalid format: ${file.type}. Only JPG, PNG, WEBP allowed`;
                            error = { field, label, reason, type: 'file' };
                        } else if (file.size > maxSize) {
                            const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                            reason = `File too large: ${sizeMB}MB. Maximum 1MB allowed`;
                            error = { field, label, reason, type: 'file' };
                        }
                    }
                }
                // Date validation
                else if (fieldType === 'date' && !value) {
                    reason = 'Date is required. Please select a valid date';
                    error = { field, label, reason, type: 'date' };
                }
                // Email validation
                else if (fieldType === 'email' && value && !value.includes('@')) {
                    reason = 'Invalid email format. Example: student@gmail.com';
                    error = { field, label, reason, type: 'email' };
                }
                // Aadhaar validation
                else if (fieldName && fieldName.toLowerCase().includes('aadhaar') && value && !/^\d{12}$/.test(value.replace(/\D/g, ''))) {
                    reason = 'Aadhaar card must be 12 digits';
                    error = { field, label, reason, type: 'aadhaar' };
                }
                // Phone/Tel validation
                else if ((fieldType === 'tel' || fieldName.includes('obile')) && value && !/^\d{10}$/.test(value.replace(/\D/g, ''))) {
                    reason = 'Invalid phone: Must be exactly 10 digits (e.g., 9876543210)';
                    error = { field, label, reason, type: 'tel' };
                }
                // Select/Dropdown validation
                else if (fieldType === 'select-one' && !value) {
                    reason = `Please select a ${label.toLowerCase()}`;
                    error = { field, label, reason, type: 'select' };
                }
                // Text/Textarea validation
                else if (!value) {
                    const extractedFieldName = fieldName ? fieldName.replace(/^data\[|\]$/g, '') : fieldId;
                    reason = VALIDATION_REASON_MAP[extractedFieldName] || `${label} cannot be empty`;
                    error = { field, label, reason, type: 'text' };
                }

                if (error) {
                    validationErrors.push(error);
                    if (!firstEmptyField) {
                        firstEmptyField = field;
                    }
                }
            });

            let isValid = validationErrors.length === 0;
            let missingFieldsHtml = '';

            if (!isValid) {
                missingFieldsHtml = `
                    <div style="text-align: left; background: #fff3cd; border-left: 4px solid #dc3545; padding: 15px; border-radius: 5px; max-height: 400px; overflow-y: auto;">
                        <h5 style="color: #dc3545; margin-top: 0; display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-exclamation-triangle-fill"></i> 
                            <span>${validationErrors.length} Required Field${validationErrors.length > 1 ? 's' : ''} Missing</span>
                        </h5>
                        <ul style="margin-bottom: 0; color: #333; padding-left: 20px;">
                `;
                
                validationErrors.forEach((error, index) => {
                    missingFieldsHtml += `
                        <li style="margin-bottom: 12px; padding: 8px; background: #ffe6e6; border-radius: 4px; border-left: 3px solid #dc3545;">
                            <strong>${index + 1}. ${error.label}</strong>
                            <div style="font-size: 0.9em; color: #c82333; margin-top: 4px;">
                                ↳ ${error.reason}
                            </div>
                        </li>
                    `;
                });
                
                missingFieldsHtml += `
                        </ul>
                        <div style="margin-top: 12px; padding: 10px; background: #fff; border-radius: 4px; font-size: 0.9em; color: #666;">
                            <strong>💡 Tip:</strong> Fix the errors above and try submitting again. Invalid fields are highlighted in red.
                        </div>
                    </div>
                `;
            }

            return {
                isValid: isValid,
                missingFieldsHtml: missingFieldsHtml,
                firstEmptyField: firstEmptyField,
                validationErrors: validationErrors
            };
        }

        /**
         * Real-time validation on blur - show error if field is empty
         */
        form.querySelectorAll('[required]').forEach(field => {
            // Show error on blur
            field.addEventListener('blur', function() {
                const value = String(this.value || '').trim();
                if (!value) {
                    showFieldError(this);
                } else {
                    clearFieldError(this);
                }
            });

            // Remove error while typing
            field.addEventListener('input', function() {
                clearFieldError(this);
            });

            field.addEventListener('change', function() {
                const value = String(this.value || '').trim();
                if (!value) {
                    showFieldError(this);
                } else {
                    clearFieldError(this);
                }
            });
        });

        form.querySelectorAll('input[name*="[aadhaar]"], input[type="tel"]').forEach(field => {
            field.addEventListener('blur', function() {
                const value = String(this.value || '').trim();
                if (!value) {
                    clearFieldError(this);
                    return;
                }

                const fieldName = (this.getAttribute('name') || '').toLowerCase();
                const digits = value.replace(/\D/g, '');
                const isAadhaarField = fieldName.includes('aadhaar');
                const isPhoneField = this.getAttribute('type') === 'tel';

                if ((isAadhaarField && digits.length !== 12) || (isPhoneField && digits.length !== 10)) {
                    showFieldError(this);
                } else {
                    clearFieldError(this);
                }
            });

            field.addEventListener('input', function() {
                const value = String(this.value || '').trim();
                if (!value) {
                    clearFieldError(this);
                    return;
                }

                const fieldName = (this.getAttribute('name') || '').toLowerCase();
                const digits = value.replace(/\D/g, '');
                const isAadhaarField = fieldName.includes('aadhaar');
                const isPhoneField = this.getAttribute('type') === 'tel';

                if ((isAadhaarField && digits.length !== 12) || (isPhoneField && digits.length !== 10)) {
                    showFieldError(this);
                } else {
                    clearFieldError(this);
                }
            });
        });

        /**
         * Show inline error message below a field with detailed reasons
         */
        function showFieldError(field) {
            clearFieldError(field); // Remove any existing error first

            const fieldId = field.getAttribute('id');
            const fieldName = field.getAttribute('name');
            const fieldType = field.getAttribute('type') || field.tagName.toLowerCase();
            const value = String(field.value || '').trim();
            
            let label = document.querySelector(`label[for="${fieldId}"]`)?.innerText || 
                       field.parentElement?.querySelector('label')?.innerText || 
                       field.getAttribute('placeholder') || 'This field';
            label = label.replace(/\s*\*\s*$/, '').trim();

            // Get specific error reason from map, or build dynamic reason
            let extractedFieldName = fieldName ? fieldName.replace(/^data\[|\]$/g, '') : fieldId;
            let errorMessage = VALIDATION_REASON_MAP[extractedFieldName] || 'This field is required';

            // File input specific errors
            if (fieldType === 'file') {
                const fileInput = document.getElementById(fieldId);
                if (!fileInput.files || fileInput.files.length === 0) {
                    errorMessage = VALIDATION_REASON_MAP['studentPhoto'] || 'Student Photo is required';
                } else {
                    const file = fileInput.files[0];
                    const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                    errorMessage = `${label}: ${file.size > 1048576 ? `File too large (${sizeMB}MB, max 1MB)` : 'Invalid format (JPG, PNG, WEBP only)'}`;
                }
            }
            // Date field errors
            else if (fieldType === 'date') {
                errorMessage = 'Date of Birth must be a valid date';
            }
            // Email field errors
            else if (fieldType === 'email') {
                if (!value.includes('@')) {
                    errorMessage = VALIDATION_REASON_MAP['email'] || 'Invalid email format';
                }
            }
            // Aadhaar field errors
            else if (fieldName && fieldName.toLowerCase().includes('aadhaar')) {
                if (value && !/^\d{12}$/.test(value.replace(/\D/g, ''))) {
                    errorMessage = VALIDATION_REASON_MAP['aadhaar_format'] || 'Aadhaar card must be 12 digits';
                }
            }
            // Phone/Tel field errors
            else if (fieldType === 'tel' || (fieldName && fieldName.includes('mobile'))) {
                if (value && !/^\d{10}$/.test(value.replace(/\D/g, ''))) {
                    errorMessage = VALIDATION_REASON_MAP['mobile_format'] || 'Phone must be exactly 10 digits';
                }
            }
            // Select/Dropdown errors
            else if (fieldType.includes('select')) {
                errorMessage = `Please select a ${label.toLowerCase()}`;
            }

            // Apply red styling
            field.classList.add('is-invalid');
            field.style.borderColor = '#dc3545';
            field.style.boxShadow = '0 0 8px rgba(220, 53, 69, 0.4)';

            let errorMsg = field.parentNode.querySelector('.field-error-message');
            if (!errorMsg) {
                errorMsg = document.createElement('small');
                errorMsg.className = 'field-error-message';
                field.insertAdjacentElement('afterend', errorMsg);
            }

            errorMsg.innerHTML = `<i class="bi bi-exclamation-circle-fill"></i> ${errorMessage}`;
            errorMsg.style.display = 'block';
        }

        /**
         * Clear inline error message and styling
         */
        function clearFieldError(field) {
            field.classList.remove('is-invalid');
            field.style.borderColor = '';
            field.style.boxShadow = '';

            // Remove error message if exists
            const errorMsg = field.parentNode.querySelector('.field-error-message');
            if (errorMsg) {
                errorMsg.innerHTML = '';
                errorMsg.style.display = 'none';
            }
        }

        // Add CSS for animations and styling
        const style = document.createElement('style');
        style.textContent = `
            @keyframes shake {
                0%, 100% { transform: translateX(0); }
                25% { transform: translateX(-10px); }
                75% { transform: translateX(10px); }
            }
            @keyframes slideDown {
                from {
                    opacity: 0;
                    transform: translateY(-5px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            .is-invalid {
                border-color: #dc3545 !important;
                background-color: #fff8f9 !important;
            }
            .field-error-message {
                color: #dc3545;
                font-size: 0.875rem;
                display: none;
                margin-top: 5px;
                font-weight: 500;
                animation: slideDown 0.3s ease-out;
                padding: 5px 8px;
                background: #ffe6e6;
                border-radius: 4px;
            }
        `;
        document.head.appendChild(style);
    </script>
